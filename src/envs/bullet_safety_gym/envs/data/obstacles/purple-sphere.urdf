<?xml version="0.0" ?>
<robot name="purple-sphere">
  <link name="base_link">
    <inertial>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.7"/>
      </geometry>
      <material name="purple">
        <color rgba="0.5 0.15 0.9 1.0"/>
      </material>
      <origin xyz="0 0 0.5"/>
    </visual>
  </link>
</robot>

