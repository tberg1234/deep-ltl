<?xml version="0.0" ?>
<robot name="beige-sphere">
  <link name="base_link">
    <inertial>
      <mass value="5"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="1 1 1.5"/>
      </geometry>
      <material name="beige">
        <color rgba="0.96 0.96 0.86 1.0"/>
      </material>
      <origin xyz="0 0 0.75"/>
    </visual>
  </link>
</robot>

